---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
interface Props {
  title?: string;
  description?: string;
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto', label: 'Contacto' },
];
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/marslabs-icon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="mars-glow min-h-screen flex flex-col">
      <header class="border-b border-border/60 backdrop-blur sticky top-0 z-50 bg-background/80">
        <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
          <a href="/" class="flex items-center gap-3" aria-label="Mars Labs — inicio">
            <img src="/brand/marslabs-icon.svg" alt="" class="h-9 w-9 rounded-lg" width="36" height="36" />
            <span class="font-extrabold tracking-tight text-lg">Mars<span class="font-medium text-muted-foreground">Labs</span></span>
          </a>
          <div class="hidden sm:flex items-center gap-6 text-sm text-muted-foreground">
            {nav.map((item) => (
              <a href={item.href} class="hover:text-foreground transition-colors">{item.label}</a>
            ))}
          </div>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-border/60">
        <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted-foreground">
          <div class="flex items-center gap-2">
            <img src="/brand/marslabs-icon.svg" alt="" class="h-6 w-6 rounded" width="24" height="24" />
            <span>Mars Labs — desarrollo · infraestructura · medios</span>
          </div>
          <span>© {new Date().getFullYear()} Mars Labs</span>
        </div>
      </footer>
    </div>
  </body>
</html>