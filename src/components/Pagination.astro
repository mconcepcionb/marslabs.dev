---
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  base: string;
}

const { page, base } = Astro.props;

const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const pageHref = (n: number) => (n === 1 ? `${base}/` : `${base}/${n}/`);
const prevHref = page.currentPage > 1 ? pageHref(page.currentPage - 1) : undefined;
const nextHref = page.currentPage < page.lastPage ? pageHref(page.currentPage + 1) : undefined;

const itemClass =
  'inline-flex items-center justify-center h-10 w-10 rounded-lg border border-border font-mono text-sm transition-colors';
const activeClass = 'border-primary/60 bg-primary/10 text-primary';
const idleClass = 'hover:border-accent/60 hover:text-accent';
const disabledClass = 'pointer-events-none opacity-40';
---

<nav class="mt-14 flex items-center justify-center gap-2" aria-label="Paginación del blog">
  {
    prevHref ? (
      <a href={prevHref} class={`${itemClass} ${idleClass}`} aria-label="Página anterior">←</a>
    ) : (
      <span class={`${itemClass} ${disabledClass}`} aria-hidden="true">←</span>
    )
  }

  {pages.map((n) => (
    <a
      href={pageHref(n)}
      aria-current={n === page.currentPage ? 'page' : undefined}
      class={`${itemClass} ${n === page.currentPage ? activeClass : idleClass}`}
    >
      {n}
    </a>
  ))}

  {
    nextHref ? (
      <a href={nextHref} class={`${itemClass} ${idleClass}`} aria-label="Página siguiente">→</a>
    ) : (
      <span class={`${itemClass} ${disabledClass}`} aria-hidden="true">→</span>
    )
  }
</nav>