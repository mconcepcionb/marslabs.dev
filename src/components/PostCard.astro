---
import type { CollectionEntry } from 'astro:content';
import { slugifyTag } from '../lib/tags';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const tagHref = (tag: string) => `/blog/tags/${slugifyTag(tag)}/`;
const date = post.data.date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="relative rounded-2xl border border-border bg-card p-8 transition-colors hover:border-accent/40">
  <div class="mb-3 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <div class="flex flex-wrap gap-2">
      {
        post.data.tags.map((tag) => (
          <a
            href={tagHref(tag)}
            class="chip relative z-10 transition-colors hover:border-accent/60 hover:text-accent"
          >#{tag}</a>
        ))
      }
    </div>
  </div>

  <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">
    <h2 class="text-xl font-bold transition-colors hover:text-accent">{post.data.title}</h2>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{post.data.summary}</p>
  </a>
</article>