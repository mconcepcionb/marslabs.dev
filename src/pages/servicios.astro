---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Servicios — Mars Labs">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Servicios</h1>
    <p class="text-muted-foreground max-w-2xl mb-12">
      Tres líneas de trabajo, un mismo método: definir el alcance, validar la
      arquitectura con medición real y entregar con criterios de aceptación explícitos.
    </p>

    <div class="space-y-8">
      {
        services.map((service) => (
          <article class="rounded-2xl border border-border bg-card p-8 hover:border-accent/40 transition-colors">
            <div class="flex items-start gap-4">
              <span class="text-primary mt-1" set:html={service.data.icon} />
              <div>
                <h2 class="text-xl font-bold mb-2">{service.data.title}</h2>
                <p class="text-sm text-muted-foreground leading-relaxed mb-4">{service.data.summary}</p>
                <a
                  href={`/servicios/${service.id}/`}
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:opacity-80 transition-opacity"
                >Ver detalle
                  <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>