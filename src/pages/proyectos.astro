---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { projectMeta, STATUS_CLASS, STATUS_LABEL } from '../lib/content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Proyectos — Mars Labs">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Proyectos</h1>
    <p class="text-muted-foreground max-w-2xl mb-12">
      Trabajo con alcance real: qué se pidió, qué se midió, qué se entregó.
    </p>

    <div class="space-y-8">
      {
        projects.map((project) => (
          <article class="rounded-2xl border border-border bg-card p-8 hover:border-accent/40 transition-colors">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div>
                <h2 class="text-xl font-bold mb-1">{project.data.title}</h2>
                <p class="text-xs text-muted-foreground uppercase tracking-wider mb-3">{projectMeta(project)}</p>
              </div>
              <span class={`chip ${STATUS_CLASS[project.data.status]}`}>{STATUS_LABEL[project.data.status]}</span>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">{project.data.summary}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <span class="chip chip--primary">#{tag}</span>
              ))}
            </div>
            <a
              href={`/proyectos/${project.id}/`}
              class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:opacity-80 transition-opacity"
            >Ver caso
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>