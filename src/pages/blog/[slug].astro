---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — Mars Labs`} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-10">
      <div class="flex items-center gap-3 text-sm text-muted-foreground mb-4">
        <a href="/blog" class="hover:text-accent transition-colors">← Blog</a>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-balance">{post.data.title}</h1>
      <div class="mt-4 flex gap-2 flex-wrap">
        {
          post.data.tags.map((tag) => (
            <span class="rounded-full border border-border text-xs px-2.5 py-1 text-muted-foreground">#{tag}</span>
          ))
        }
      </div>
    </header>

    <div class="prose prose-invert max-w-none prose-headings:text-foreground prose-p:text-muted-foreground prose-a:text-accent prose-strong:text-foreground prose-li:text-muted-foreground prose-code:text-accent">
      <Content />
    </div>
  </article>
</Layout>