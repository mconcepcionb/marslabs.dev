---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Blog — Mars Labs">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Blog</h1>
    <p class="text-muted-foreground max-w-2xl mb-12">
      Arquitectura, infraestructura y oficio del desarrollo — escritos con el
      mismo método que el trabajo: medir antes de afirmar.
    </p>

    <div class="space-y-8">
      {
        posts.map((post) => (
          <article class="rounded-2xl border border-border bg-card p-8 hover:border-accent/40 transition-colors">
            <a href={`/blog/${post.id}/`} class="block">
              <div class="flex items-center gap-3 text-xs text-muted-foreground mb-3">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {
                  post.data.tags.map((tag) => (
                    <span class="rounded-full border border-border px-2 py-0.5">#{tag}</span>
                  ))
                }
              </div>
              <h2 class="text-xl font-bold hover:text-accent transition-colors">{post.data.title}</h2>
              <p class="text-sm text-muted-foreground mt-2 leading-relaxed">{post.data.description}</p>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>